# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Any provider LangChain's init_chat_model supports, e.g. anthropic, openai,
# google_genai, mistralai, ollama, groq, bedrock_converse.
# Providers other than anthropic need their package: pip install -e ".[openai]"
LLM_PROVIDER=anthropic

# Optional for anthropic (default: claude-haiku-5-5). Required for others.
LLM_MODEL=

# The API key variable your provider's LangChain package reads. Set only the
# one you use, e.g. ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_API_KEY,
# MISTRAL_API_KEY, GROQ_API_KEY. Local providers such as ollama need none.
ANTHROPIC_API_KEY=

# Optional but recommended. Without it GitHub allows 60 requests/hour.
# A fine-grained token with read-only access to public repos is enough.
GITHUB_TOKEN=

# Optional. Where last-run snapshots are kept. Default: ./.monday_triage/
MONDAY_TRIAGE_STATE_DIR=
